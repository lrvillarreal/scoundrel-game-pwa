{
  "name": "scoundrel-game-pwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm test && npm run lint && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predev": "node scripts/prepare-artwork.mjs",
    "prebuild": "node scripts/prepare-artwork.mjs",
    "test": "node tests/test-game.mjs && node --test tests/interface.test.mjs tests/pwa.test.mjs",
    "test:offline": "npm run build && playwright test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "~27.4.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "~7.3.8"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
